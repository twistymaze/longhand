# npm settings for this project (docs/development-workflow.md).

# Take a package version only after it is 7 days old. Most malicious
# package versions are found and removed within a few days. For an exact
# younger version, see "Dependency age" in docs/development-workflow.md.
min-release-age=7

# Stop the install when a dependency has an install script that
# package.json "allowScripts" does not name. Each entry there has a reason
# in docs/development-workflow.md.
strict-allow-scripts=true

# Take packages only from the registry: no git or remote-URL dependencies.
allow-git=none
allow-remote=none
