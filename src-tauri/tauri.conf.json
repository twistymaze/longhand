{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Longhand",
  "version": "0.1.0",
  "identifier": "net.ewal.longhand",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun scripts/prepare-nemo.ts && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "hardenedRuntime": true,
      "minimumSystemVersion": "15.0",
      "signingIdentity": "Developer ID Application: Ervin Walter (7GLQLN8HXK)",
      "entitlements": "Entitlements.plist",
      "files": {
        "Frameworks/LonghandNeMo": "nemo-runtime/bin"
      }
    }
  }
}
