# The licence texts and the generated full list keep LF line ends on every
# platform, so the drift check (scripts/check-licences.sh) compares the same bytes.
licences/** text eol=lf

# Golden test files keep LF line ends, so the tests compare the same bytes
# on Windows as on macOS.
crates/*/tests/golden/** text eol=lf

# The test storage folder keeps LF line ends, so the Rust tests and the
# script tests read the same bytes on Windows as on macOS (KTD13).
testdata/** eol=lf

# The audio test files of the import are binary. `eol` sets `text`, which
# would change their bytes, so this rule turns it off for them.
testdata/audio-import/*.m4a binary
testdata/audio-import/*.mp3 binary
testdata/audio-import/*.wav binary

# The skill's copy of the built-in prompts keeps LF line ends, so the skill
# drift test compares the same bytes on Windows as on macOS.
plugins/longhand/skills/longhand-notes/references/built-in-prompts.md text eol=lf

# npm writes LF line ends; keep them on every platform so the lockfile
# checks read the same bytes on Windows as on macOS.
package-lock.json text eol=lf
