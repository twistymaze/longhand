# The licence texts and the generated full list keep LF line ends on every
# platform, so the drift check (scripts/check-licences.sh) compares the same bytes.
licences/** text eol=lf

# Golden test files keep LF line ends, so the tests compare the same bytes
# on Windows as on macOS.
crates/*/tests/golden/** text eol=lf

# The test storage folder keeps LF line ends, so the Rust tests and the
# script tests read the same bytes on Windows as on macOS (KTD13).
testdata/** eol=lf
