{
  "name": "longhand",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.15.0 || ^26.0.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=12.2.0 <13",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:scripts": "node --test \"scripts/**/*.test.ts\"",
    "screenshots": "node scripts/screenshots.ts",
    "site": "vite --config site/vite.config.ts",
    "tauri": "tauri"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.6",
    "@handlewithcare/react-prosemirror": "3.2.6",
    "@tailwindcss/vite": "^4.1.16",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-opener": "^2",
    "markdown-it": "^14.2.0",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-dropcursor": "^1.8.2",
    "prosemirror-gapcursor": "1.4.0",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.4",
    "prosemirror-model": "^1.25.4",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "1.12.1",
    "prosemirror-view": "1.42.3",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "react-reconciler": "0.33.0",
    "tailwindcss": "^4.1.16",
    "tauri-plugin-macos-permissions-api": "2.3.0",
    "tlds": "^1.261.0"
  },
  "overrides": {
    "prosemirror-view": "1.42.3"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.9.1",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright-core": "1.53.0",
    "rollup-plugin-license": "3.7.1",
    "typescript": "~5.6.3",
    "vite": "^6.4.4",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  }
}
